   "source": [
    "import asyncio\n",
    "\n",
    "async def task(name, delay):\n",
    "    print(f\"{name} started\")\n",
    "    await asyncio.sleep(delay)\n",
    "    print(f\"{name} finished\")\n",
    "\n",
    "async def main():\n",
    "    t=await task(\"Task 1\", 2)\n",
    "    t=await task(\"Task 2\", 2)\n",
    "   "
   ]
  }
